generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  DRAFT
  PENDING_INTERNAL_APPROVAL // For late submissions
  AWAITING_CLIENT_APPROVAL
  APPROVED
  PRINT_READY
  DELIVERED
}

enum TemplateCategory {
  FUNERAL_PROGRAM
  PRAYER_CARD
  THANK_YOU_CARD
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  role     String // 'STAFF', 'ADMIN'
  orders   Order[]
}

model Template {
  id               String           @id @default(uuid())
  canvaTemplateId  String           @unique
  name             String
  category         TemplateCategory
  dimensions       String           // e.g., "8.5x11"
  requiredFields   Json             // List of keys: ["deceased_name", "obituary", "date_of_birth"]
  orders           Order[]
}

model Order {
  id               String      @id @default(uuid())
  clientId         String
  clientEmail      String
  dueDate          DateTime
  status           OrderStatus  @default(DRAFT)
  templateId       String
  template         Template    @relation(fields: [templateId], references: [id])
  staffId          String
  staff            User        @relation(fields: [staffId], references: [id])
  data             Json         // The extracted/entered values for the template
  proofUrl         String?
  finalPdfUrl      String?
  isLate           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ApprovalLog {
  id        String   @id @default(uuid())
  orderId   String
  action    String   // 'CLIENT_APPROVED', 'ADMIN_OVERRIDE'
  timestamp DateTime @default(now())
  userId    String?   // ID of the staff/admin who took action
}
