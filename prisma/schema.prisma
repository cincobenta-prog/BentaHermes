generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  role     String // 'STAFF', 'ADMIN'
  orders   Order[]
}

model Template {
  id               String           @id @default(uuid())
  canvaTemplateId  String           @unique
  name             String
  category         String           // 'FUNERAL_PROGRAM', 'PRAYER_CARD', 'THANK_YOU_CARD'
  dimensions       String           // e.g., "8.5x11"
  requiredFields   String           // JSON string: ["deceased_name", "obituary", "date_of_birth"]
  orders           Order[]
}

model Order {
  id               String      @id @default(uuid())
  clientId         String
  clientEmail      String
  dueDate          DateTime
  status           String      @default("DRAFT") // 'DRAFT', 'PENDING_INTERNAL_APPROVAL', 'AWAITING_CLIENT_APPROVAL', 'APPROVED', 'PRINT_READY', 'DELIVERED'
  templateId       String
  template         Template    @relation(fields: [templateId], references: [id])
  staffId          String
  staff            User        @relation(fields: [staffId], references: [id])
  data             String      // JSON string of extracted/entered values
  proofUrl         String?
  finalPdfUrl      String?
  isLate           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ApprovalLog {
  id        String   @id @default(uuid())
  orderId   String
  action    String   // 'CLIENT_APPROVED', 'ADMIN_OVERRIDE'
  timestamp DateTime @default(now())
  userId    String?   // ID of the staff/admin who took action
}

model Appointment {
  id           String   @id @default(uuid())
  guestName    String
  companyName  String
  guestEmail   String
  startTime    DateTime
  endTime      DateTime
  createdAt    DateTime @default(now())
}